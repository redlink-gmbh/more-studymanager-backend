# Copy to .env and adjust. Values shown are the defaults from application.yaml.

# Required: the application refuses to start unless set to true
MORE_ACCEPT_OPERATOR_TERMS=false

# OAuth2 / Keycloak
OAUTH2_SERVER=https://auth.more.redlink.io/realms/Auth-Client-Test
OAUTH2_CLIENT_ID=oauth2-pkce-client
OAUTH2_CLIENT_SECRET=

# Frontend
MORE_FE_TITLE=MORE Studymanager
MORE_FE_KC_SERVER=https://auth.more.redlink.io/
MORE_FE_KC_REALM=Auth-Client-Test
MORE_FE_KC_CLIENT_ID=oauth2-pkce-client

# Postgres (POSTGRES_DB is used by docker-compose, POSTGRES_DBNAME by the app)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=more
POSTGRES_DBNAME=more
POSTGRES_USER=more
POSTGRES_PASSWORD=more

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch / Kibana
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
KIBANA_URI=http://localhost:5601

# Push service
PUSH_SERVICE_URL=http://localhost:8090
PUSH_SERVICE_API_KEY=

# URLs
GATEWAY_BASE_URL=http://localhost:8085
PARTICIPANT_PORTAL_URL=http://localhost:3001

# LimeSurvey
LIME_ADMIN_USER=more-admin
LIME_ADMIN_PWD=more-admin
LIME_BASE_URL=https://lime.platform-test.more.redlink.io
LIME_URL=https://lime.platform-test.more.redlink.io/admin/remotecontrol
LIME_SURVEY_URL=https://lime.platform-test.more.redlink.io/index.php
LIME_END_SURVEY_URL=https://studymanager.platform-test.more.redlink.io/api/v1/components/observation/lime-survey-observation/end.html

# Login tokens
LOGIN_TOKEN_ENCRYPTION_KEY=
LOGIN_TOKEN_SALT_KEY=
LOGIN_TOKEN_HASH_ALGORITHM=SHA-256
